# --- Supabase (Kundenportal: Auth, Datenbank, Storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable/anon Key (öffentlich, browser-safe bei aktivem RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# --- E-Mail (Kontaktformular und Portal-Benachrichtigungen) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_password
# Für Port 465 (SSL):
# SMTP_SECURE=true

# --- Kundenportal ---
# Empfänger der Benachrichtigungen bei Kommentar und Freigabe
PORTAL_ADMIN_EMAIL=admin@example.com
