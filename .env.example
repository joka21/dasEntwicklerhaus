# Platzhalter für alle Umgebungsvariablen. Für die lokale Entwicklung als
# .env.local kopieren und ausfüllen (.env.local wird nicht eingecheckt).

# --- Datenbank (PostgreSQL 18 + pgvector) ---
# Lokal: docker compose -f docker-compose.dev.yml up -d
# Mittwald: postgres://<benutzer>:<passwort>@pgvector:5432/entwicklerhaus
DATABASE_URL=postgres://entwicklerhaus:entwicklerhaus_dev@localhost:5432/entwicklerhaus

# --- Supabase (bisheriges Kundenportal, entfällt nach dem Umzug) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable Key (sb_publishable_…, öffentlich, browser-safe bei aktivem RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# --- E-Mail (Kontaktformular und Portal-Benachrichtigungen) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_password
# Für Port 465 (SSL):
# SMTP_SECURE=true

# --- Kundenportal ---
# Empfänger der Benachrichtigungen bei Kommentar und Freigabe
PORTAL_ADMIN_EMAIL=admin@example.com
